generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Source {
  id          String        @id @default(cuid())
  name        String
  type        String
  baseUrl     String
  feedUrl     String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  content     ContentItem[]
  ingestionRuns IngestionRun[]

  @@unique([name, baseUrl])
}

model ContentItem {
  id                 String          @id @default(cuid())
  externalId         String?
  title              String
  summary            String
  fullUrl            String          @unique
  sourceName         String
  sourceId           String?
  source             Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  publishedAt        DateTime?
  fetchedAt          DateTime        @default(now())
  category           String
  subcategory        String?
  tags               Json
  region             String?
  relevanceScore     Float           @default(0)
  trendScore         Float           @default(0)
  contentType        String
  extractedSkills    Json
  extractedTools     Json
  extractedCompanies Json
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([category, publishedAt])
  @@index([trendScore])
  @@index([relevanceScore])
}

model IngestionRun {
  id           String   @id @default(cuid())
  sourceId     String?
  source       Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  status       String
  message      String?
  itemsCreated Int      @default(0)
  itemsUpdated Int      @default(0)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
}
